{
  "expo": {
    "name": "SyndicateOS",
    "slug": "sos",
    "owner": "krishisetu",
    "extra": {
      "eas": {
        "projectId": "2e26af93-eb82-40e1-8910-9209003b0275"
      }
    },
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "syndicateos-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f6f4ec",
      "image": "./assets/brand/logo-stacked.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "in.krishisetu9.syndicateos",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#F59E0B"
      }
    },
    "web": {
      "favicon": "./assets/brand/mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-stacked.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f6f4ec",
          "android": {
            "image": "./assets/brand/splash-android-safe.png",
            "imageWidth": 288,
            "resizeMode": "contain",
            "backgroundColor": "#f6f4ec"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
